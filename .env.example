# ============================================================
# HireLens (聘镜) v3.0 全链路智能求职系统配置模板
# 复制本文件为 .env 或直接在 Web 界面「飞书与系统配置」热更新
# ============================================================

BIND_HOST=127.0.0.1
WEB_PORT=8765
# 可选：开启本地接口令牌保护（防跨站或局域网未授权写入）
LOCAL_API_TOKEN=

# 1. 核心文本大模型（兼容 DeepSeek / OpenAI / 通义千问 / 智谱 / Ollama）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 2. 截图识岗视觉引擎（留空默认调用 macOS 原生离线 Apple Vision OCR 零成本识图）
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# 3. 飞书全生态协同（强烈建议使用【个人注册的飞书免费版】，切勿使用在职公司企业飞书！）
# 模式A：极简群机器人 Webhook（1分钟接入富文本战报与高分岗卡片）
FEISHU_WEBHOOK_URL=
# 模式B：飞书开放平台自建应用（支持一键自动建多维表格、手机端双向同步审批、机器人对话）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_JOBS_TABLE_ID=
FEISHU_RESUMES_TABLE_ID=
FEISHU_CHAT_ID=

# 4. 公司背调联网搜索增强（可选，支持 Serper Google Search API）
SERPER_API_KEY=

# 5. 多平台巡航与拟人防封投递安全阀
DRY_RUN=true
DAILY_DELIVERY_LIMIT=35
BROWSER_DEBUG_PORT=19333
